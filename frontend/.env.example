# Variables del frontend (Vite). Copiar a .env.local solo si se necesitan; en local no hace falta ninguna.
# Valores de ejemplo, NO reales. Lo que empieza por VITE_ queda dentro del build y es publico: nunca secretos.

# URL del servidor de sockets (Orders). En produccion el frontend esta en Vercel, que no reenvia websockets: se
# pone la URL publica de Orders en Render, por ejemplo https://gastrocore-orders.onrender.com
# Sin definir (local) el socket usa el mismo origen de la pagina, como siempre (nginx o el proxy de Vite).
VITE_WS_URL=
