# Copiar a .env.render (fuera de git) para los scripts scripts/render-db-*.sh y scripts/render-seed.sh, que se
# ejecutan desde tu PC contra la base de Render. Valores de ejemplo, NO reales.

# URL EXTERNA de la base en Render (panel > la base > Connect > External Database URL). Es su administrador: crea
# roles y bases pero no es superusuario. Al renovar la base (30 dias) se cambia por la de la base nueva.
RENDER_ADMIN_URL=postgresql://gastrocore_admin:change_me@dpg-ejemplo-a.virginia-postgres.render.com/gastrocore

# Contrasena del usuario de cada servicio en Render (solo letras y numeros; distintas a las locales).
# Generar, por ejemplo: openssl rand -hex 24
AUTH_DB_PASSWORD=change_me_auth
STAFF_DB_PASSWORD=change_me_staff
CATALOG_DB_PASSWORD=change_me_catalog
ORDERS_DB_PASSWORD=change_me_orders

# Primer administrador (bash scripts/render-seed.sh admin). Minimo 10 caracteres.
ADMIN_EMAIL=admin@lapizzeta.com
ADMIN_PASSWORD=change_me_admin_password

# Solo si se cargan los datos de demostracion (bash scripts/render-seed.sh demo). Minimo 10 caracteres.
DEMO_PASSWORD=change_me_demo_password
