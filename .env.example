# Copiar a .env y ajustar. Valores de ejemplo, NO reales.
# Usa solo letras y numeros en las contrasenas (van dentro de DATABASE_URL).
NODE_ENV=development

# Origen permitido por CORS (dominio del sistema)
CORS_ORIGIN=http://localhost

# Superusuario de PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_example

# Una contrasena por base (un usuario PostgreSQL por microservicio)
AUTH_DB_PASSWORD=change_me_auth
STAFF_DB_PASSWORD=change_me_staff
CATALOG_DB_PASSWORD=change_me_catalog
ORDERS_DB_PASSWORD=change_me_orders

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@gastrocore.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin

# Primer administrador (se crea con: docker compose exec auth npm run seed:admin)
# La contrasena debe tener al menos 10 caracteres
ADMIN_EMAIL=admin@lapizzeta.com
ADMIN_PASSWORD=change_me_admin_password

# Datos de demostracion (se crean con: bash scripts/seed-demo.sh). Contrasena comun de los usuarios de ejemplo
# (mesero1, mesero2, mesero3 y cocinero1 @lapizzeta.com), minimo 10 caracteres. Si no se define se usa una por defecto.
# Solo para desarrollo y demos: el seed no corre con NODE_ENV=production (salvo SEED_DEMO_FORCE=true).
DEMO_PASSWORD=change_me_demo_password

# Token para las llamadas entre servicios en /internal/* (cabecera X-Service-Token).
# Obligatorio para que Staff acepte consultas internas (si esta vacio las rechaza todas).
# Usa un valor largo y aleatorio, por ejemplo: openssl rand -hex 32
SERVICE_TOKEN=change_me_service_token
